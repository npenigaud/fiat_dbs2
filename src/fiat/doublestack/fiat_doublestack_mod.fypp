#:set verbosecontent=['.FALSE.']
#:for verbose in verbosecontent
MODULE FIAT_DOUBLESTACK_MOD

USE EC_PARKIND, ONLY : JPIM, JPIB, JPRM, JPRD
USE ISO_C_BINDING, ONLY : C_PTR, C_SIZE_T, C_LOC, C_F_POINTER, C_ASSOCIATED, C_NULL_PTR,C_INT8_T,C_INTPTR_T
#ifdef ACCGPU
USE OPENACC
#endif

IMPLICIT NONE

PRIVATE 

#:set ranks = list (range (1,6))
#:set types = ['INTEGER', 'INTEGER', 'REAL', 'REAL']
#:set kinds = ['IM', 'IB', 'RM', 'RD']
#:set bounds = ['IM','IB']

PUBLIC :: FIAT_DOUBLESTACK

TYPE FIAT_DOUBLESTACK
  INTEGER(KIND=C_INT8_T), POINTER :: PTR(:)
  INTEGER(KIND=C_SIZE_T) :: INDEX_UP
  INTEGER(KIND=C_SIZE_T) :: INDEX_UP_0
  INTEGER(KIND=C_SIZE_T) :: INDEX_LOW
  INTEGER(KIND=C_SIZE_T) :: INDEX_LOW_0
  LOGICAL                :: LLGPU
  INTEGER(KIND=C_SIZE_T) :: ALIGNMENT=128 !8
CONTAINS
  PROCEDURE :: INIT => FIAT_DOUBLESTACK_INIT
  PROCEDURE :: FINAL => FIAT_DOUBLESTACK_FINAL
#:for rank in ranks
#:for type, kind in zip (types, kinds)
#:for bound in bounds
  PROCEDURE, PRIVATE :: FIAT_ALLOCATE_${bound}$${rank}$${kind}$
  GENERIC :: ALLOCATE => FIAT_ALLOCATE_${bound}$${rank}$${kind}$
#:endfor
#:endfor
#:endfor
#:for rank in ranks
#:for type, kind in zip (types, kinds)
  PROCEDURE, PRIVATE :: FIAT_DEALLOCATE_${rank}$${kind}$
  GENERIC :: DEALLOCATE => FIAT_DEALLOCATE_${rank}$${kind}$
#:endfor
#:endfor
END TYPE FIAT_DOUBLESTACK

INTERFACE 
FUNCTION ALLOC_ALIGNED( ALIGNMENT, SIZE_BYTES) BIND(C,NAME='alloc_aligned')
  IMPORT C_PTR, C_SIZE_T
  TYPE(C_PTR) :: ALLOC_ALIGNED
  INTEGER(C_SIZE_T), VALUE         :: ALIGNMENT
  INTEGER(C_SIZE_T), VALUE         :: SIZE_BYTES
END FUNCTION ALLOC_ALIGNED
END INTERFACE 

INTERFACE 
SUBROUTINE FREE_ALIGNED( BUFFER) BIND(C,NAME='free_aligned')
  IMPORT C_PTR
  TYPE(C_PTR) :: BUFFER
END SUBROUTINE FREE_ALIGNED
END INTERFACE 


CONTAINS


FUNCTION SIZE_ALIGNED(SIZE_BYTES, ALIGNMENT)
  INTEGER(C_SIZE_T), INTENT(IN) :: SIZE_BYTES
  INTEGER(C_SIZE_T), INTENT(IN) :: ALIGNMENT
  INTEGER(C_SIZE_T) :: SIZE_ALIGNED 
    SIZE_ALIGNED= ((SIZE_BYTES+ALIGNMENT-1)/ALIGNMENT)*ALIGNMENT
END FUNCTION SIZE_ALIGNED

SUBROUTINE FIAT_DOUBLESTACK_NEW(DOUBLESTACK,SIZE_BYTES,LLGPU)
  TYPE(FIAT_DOUBLESTACK), INTENT(OUT) :: DOUBLESTACK
  INTEGER(C_SIZE_T), INTENT(IN) :: SIZE_BYTES
  LOGICAL, INTENT(IN) :: LLGPU
  INTEGER(C_SIZE_T) :: SIZE_BYTES_ALIGNED
  if (${verbose}$) write (0,*) "fiat_doublestack_new: allocating ",size_bytes,"bytes"
  SIZE_BYTES_ALIGNED=SIZE_ALIGNED(SIZE_BYTES,DOUBLESTACK%ALIGNMENT)
  if (${verbose}$) write (0,*) "fiat_doublestack_new: after size_aligned, allocating ",size_bytes,"bytes"
  CALL C_F_POINTER(ALLOC_ALIGNED(DOUBLESTACK%ALIGNMENT,SIZE_BYTES_ALIGNED),DOUBLESTACK%PTR,[SIZE_BYTES_ALIGNED])
  IF (LLGPU) THEN
    if (${verbose}$) write (0,*) "entering on gpu"
#ifdef ACCGPU    
    !$ACC ENTER DATA CREATE(DOUBLESTACK%PTR)
    if (${verbose}$) write (0,*) "ACCGPU branch, passed acc enter data create"
    if (${verbose}$) write (0,*) "ACCGPU branch, acc_is_present(doublestack%ptr)",acc_is_present(doublestack%ptr)
#endif
#ifdef OMPGPU
      !$OMP TARGET ENTER DATA MAP(ALLOC:DOUBLESTACK%PTR)
    if (${verbose}$) write (0,*) "OMPGPU branch, passed acc enter data create"
#endif
  ENDIF
  DOUBLESTACK%INDEX_UP=SIZE_BYTES
  DOUBLESTACK%INDEX_UP_0=SIZE_BYTES
  DOUBLESTACK%INDEX_LOW=1
  DOUBLESTACK%INDEX_LOW_0=1
  DOUBLESTACK%LLGPU=LLGPU
END SUBROUTINE FIAT_DOUBLESTACK_NEW

SUBROUTINE FIAT_DOUBLESTACK_DELETE(DOUBLESTACK)
  TYPE(FIAT_DOUBLESTACK), INTENT(INOUT) :: DOUBLESTACK
  IF ((DOUBLESTACK%INDEX_UP<DOUBLESTACK%INDEX_UP_0) .OR. (DOUBLESTACK%INDEX_LOW>DOUBLESTACK%INDEX_LOW_0)) THEN
    WRITE (0,*) "ERROR : DELETING FIAT_DOUBLESTACK WITH DATA STILL ALLOCATED"
    CALL ABORT
  ELSE
    IF (DOUBLESTACK%LLGPU) THEN
      if (${verbose}$) write (0,*) "deallocating on gpu"
#ifdef ACCGPU
      !$ACC EXIT DATA DELETE(DOUBLESTACK%PTR)
#endif
#ifdef OMPGPU
      !$OMP TARGET EXIT DATA MAP(DELETE:DOUBLESTACK%PTR)
#endif
    ENDIF
    CALL FREE_ALIGNED(C_LOC(DOUBLESTACK%PTR))
    NULLIFY(DOUBLESTACK%PTR)
  ENDIF
END SUBROUTINE FIAT_DOUBLESTACK_DELETE

SUBROUTINE FIAT_DOUBLESTACK_ALLOCATE(DOUBLESTACK, SIZE_BYTES, CPTR,SIDE)
  TYPE (FIAT_DOUBLESTACK), INTENT(INOUT) :: DOUBLESTACK
  INTEGER (C_SIZE_T), INTENT(IN) :: SIZE_BYTES
  TYPE(C_PTR), INTENT(OUT) :: CPTR
  INTEGER(C_INT8_T), POINTER :: PTR(:)
  INTEGER (C_INT8_T), INTENT(IN) :: SIDE
  INTEGER(C_SIZE_T) :: SIZE_BYTES_ALIGNED

  SIZE_BYTES_ALIGNED=SIZE_ALIGNED(SIZE_BYTES,DOUBLESTACK%ALIGNMENT)
 
  IF (SIDE==0) THEN
    IF (DOUBLESTACK%INDEX_LOW+SIZE_BYTES_ALIGNED>DOUBLESTACK%INDEX_UP) THEN
      WRITE (0,*) "ERROR : DOUBLESTACK OVERALLOCATED, LOWER SIDE"
      CALL ABORT
    ELSE
      if (${verbose}$) write (0,*) "fiat_doublestack_allocate, allocating on side 0",size_bytes,"bytes"
      PTR(1:SIZE_BYTES)=>DOUBLESTACK%PTR(DOUBLESTACK%INDEX_LOW:DOUBLESTACK%INDEX_LOW+SIZE_BYTES-1)
      DOUBLESTACK%INDEX_LOW=DOUBLESTACK%INDEX_LOW+SIZE_BYTES_ALIGNED
      CPTR=C_LOC(PTR)
    ENDIF
  ELSEIF (SIDE==1) THEN
    IF (DOUBLESTACK%INDEX_UP-SIZE_BYTES_ALIGNED<DOUBLESTACK%INDEX_LOW) THEN
      WRITE (0,*) "ERROR : DOUBLESTACK OVERALLOCATED, UPPER SIDE"
      CALL ABORT
    ELSE
      if (${verbose}$) write (0,*) "fiat_doublestack_allocate, allocating on side 1",size_bytes,"bytes"
      PTR(1:SIZE_BYTES)=>DOUBLESTACK%PTR(DOUBLESTACK%INDEX_UP-SIZE_BYTES_ALIGNED+1:DOUBLESTACK%INDEX_UP-SIZE_BYTES_ALIGNED+SIZE_BYTES)
      DOUBLESTACK%INDEX_UP=DOUBLESTACK%INDEX_UP-SIZE_BYTES_ALIGNED
      CPTR=C_LOC(PTR)
    ENDIF
  ELSE
    WRITE (0,*) "ERROR : WRONG VALUE FOR SIDE, FIAT_DOUBLESTACK_ALLOCATE"
    CALL ABORT
  ENDIF
   
END SUBROUTINE FIAT_DOUBLESTACK_ALLOCATE

SUBROUTINE FIAT_DOUBLESTACK_DEALLOCATE(DOUBLESTACK, SIZE_BYTES, CPTR)
  TYPE (FIAT_DOUBLESTACK), INTENT(INOUT) :: DOUBLESTACK
  INTEGER (C_SIZE_T), INTENT(IN) :: SIZE_BYTES
  TYPE(C_PTR), INTENT(INOUT) :: CPTR
  INTEGER (C_INT8_T) :: SIDE
  INTEGER(C_INT8_T), POINTER :: PTR_BYTES(:)
  INTEGER(C_SIZE_T)   :: SIZE_BYTES_ALIGNED
  INTEGER(C_INTPTR_T) :: LOWER_ADDR, UPPER_ADDR, CPTR_ADDR

  SIZE_BYTES_ALIGNED=SIZE_ALIGNED(SIZE_BYTES,DOUBLESTACK%ALIGNMENT)

   CPTR_ADDR=TRANSFER(CPTR,CPTR_ADDR)
   LOWER_ADDR=0
   UPPER_ADDR=0
  IF (DOUBLESTACK%INDEX_LOW-SIZE_BYTES_ALIGNED .GE. DOUBLESTACK%INDEX_LOW_0) LOWER_ADDR=TRANSFER(C_LOC(DOUBLESTACK%PTR(DOUBLESTACK%INDEX_LOW-SIZE_BYTES_ALIGNED:)),LOWER_ADDR) 
  IF (DOUBLESTACK%INDEX_UP+SIZE_BYTES_ALIGNED .LE. DOUBLESTACK%INDEX_UP_0) UPPER_ADDR=TRANSFER(C_LOC(DOUBLESTACK%PTR(DOUBLESTACK%INDEX_UP+1:)),UPPER_ADDR)
  IF ((DOUBLESTACK%INDEX_LOW-SIZE_BYTES_ALIGNED .GE. DOUBLESTACK%INDEX_LOW_0) .AND. (CPTR_ADDR==LOWER_ADDR) ) THEN
    SIDE=0
  ELSEIF ((DOUBLESTACK%INDEX_UP+SIZE_BYTES_ALIGNED .LE. DOUBLESTACK%INDEX_UP_0) .AND. (CPTR_ADDR==UPPER_ADDR)) THEN
    SIDE=1
  ELSE
    WRITE (0,*) "ERROR : DEALLOCATION ORDER, FIAT_DOUBLESTACK_DEALLOCATE"
    CALL ABORT
  ENDIF

  IF (SIDE==0) THEN
    CPTR=C_NULL_PTR
    DOUBLESTACK%INDEX_LOW=DOUBLESTACK%INDEX_LOW-SIZE_BYTES_ALIGNED
    if (${verbose}$) write (0,*) "fiat_doublestack_deallocate, deallocating on side 0",size_bytes,"bytes"
  ELSEIF (SIDE==1) THEN
    CPTR=C_NULL_PTR
    DOUBLESTACK%INDEX_UP=DOUBLESTACK%INDEX_UP+SIZE_BYTES_ALIGNED
    if (${verbose}$) write (0,*) "fiat_doublestack_deallocate, deallocating on side 1",size_bytes,"bytes"
  ELSE
    WRITE (0,*) "ERROR : WRONG VALUE FOR SIDE, FIAT_DOUBLESTACK_DEALLOCATE"
    CALL ABORT
  ENDIF

END SUBROUTINE FIAT_DOUBLESTACK_DEALLOCATE


SUBROUTINE FIAT_DOUBLESTACK_INIT (SELF, SIZE, LDGPU)

CLASS (FIAT_DOUBLESTACK) :: SELF
INTEGER (KIND=C_SIZE_T), INTENT (IN) :: SIZE
LOGICAL, INTENT(IN), OPTIONAL :: LDGPU

LOGICAL :: LLGPU

LLGPU=.FALSE.
IF (PRESENT(LDGPU)) LLGPU=LDGPU

CALL FIAT_DOUBLESTACK_NEW (SELF, SIZE, LLGPU)

END SUBROUTINE FIAT_DOUBLESTACK_INIT

SUBROUTINE FIAT_DOUBLESTACK_FINAL (SELF)

CLASS (FIAT_DOUBLESTACK) :: SELF

CALL FIAT_DOUBLESTACK_DELETE (SELF)

END SUBROUTINE FIAT_DOUBLESTACK_FINAL

#:for rank in ranks
#:for type, kind in zip (types, kinds)
#:for bound in bounds

#:set suffix = bound + str (rank) + kind

SUBROUTINE FIAT_ALLOCATE_${suffix}$ (SELF, P, UBOUNDS, LBOUNDS, SIDE_PARAM)

CLASS (FIAT_DOUBLESTACK) :: SELF
${type}$ (KIND=JP${kind}$), POINTER :: P (${ ','.join ([':'] * rank) }$) 
INTEGER (KIND=JP${bound}$), INTENT (IN) :: UBOUNDS (${rank}$)
INTEGER (KIND=JP${bound}$), INTENT (IN), OPTIONAL :: LBOUNDS (${rank}$)
INTEGER (KIND=C_INT8_T), INTENT (IN), OPTIONAL :: SIDE_PARAM

INTEGER (KIND=JP${bound}$) :: ILBOUNDS (${rank}$)
TYPE (C_PTR) :: PTR
INTEGER (KIND=C_SIZE_T) :: ISIZE
INTEGER(KIND=C_INT8_T)  :: SIDE

ILBOUNDS = 1
SIDE = 0
 if (${verbose}$) write (0,*) "fiat_allocate specific routine, ubounds",ubounds
if (${verbose}$ .and. present (lbounds)) write (0,*) "lbounds present, value",lbounds
IF (PRESENT (LBOUNDS)) ILBOUNDS = LBOUNDS
IF (PRESENT (SIDE_PARAM)) SIDE=SIDE_PARAM
!SIDE=SIDE_PARAM

IF (.NOT. ASSOCIATED (SELF%PTR)) THEN
  ALLOCATE (P (${','.join (map (lambda i: "ILBOUNDS(" + str (i) + "):UBOUNDS (" + str (i) + ")", range (1, rank+1)))}$))
  RETURN
ENDIF

ISIZE = INT (KIND (P), C_SIZE_T)
#:for i in range (1, rank+1, 1)
ISIZE = ISIZE * INT (UBOUNDS(${i}$)-ILBOUNDS(${i}$)+1, C_SIZE_T)
#:endfor

CALL FIAT_DOUBLESTACK_ALLOCATE (SELF, ISIZE, PTR, SIDE)

CALL C_F_POINTER (PTR, P, UBOUNDS-ILBOUNDS+1)

P (${ ', '.join (map (lambda i: 'ILBOUNDS (' + str (i) + '):', range (1, rank+1))) }$) => P

END SUBROUTINE FIAT_ALLOCATE_${suffix}$

#:endfor
#:endfor
#:endfor


#:for rank in ranks
#:for type, kind in zip (types, kinds)

#:set suffix = str (rank) + kind


SUBROUTINE FIAT_DEALLOCATE_${suffix}$ (SELF, P)

CLASS (FIAT_DOUBLESTACK) :: SELF
${type}$ (KIND=JP${kind}$), POINTER :: P (${ ','.join ([':'] * rank) }$) 
INTEGER(KIND=C_SIZE_T) :: SIZE_BYTES

TYPE (C_PTR) :: PTR

IF (.NOT. ASSOCIATED (P)) THEN
  RETURN
ENDIF

IF (.NOT. ASSOCIATED (SELF%PTR)) THEN
  DEALLOCATE (P)
  P => NULL ()
  RETURN
ENDIF

SIZE_BYTES= INT(KIND(P),C_SIZE_T) * SIZE(P)

PTR = C_LOC (P (${ ', '.join (map (lambda i: 'LBOUND (P, ' + str (i) + ')', range (1, rank+1))) }$))

CALL FIAT_DOUBLESTACK_DEALLOCATE (SELF, SIZE_BYTES, PTR)

P => NULL ()

END SUBROUTINE FIAT_DEALLOCATE_${suffix}$

#:endfor
#:endfor

END MODULE FIAT_DOUBLESTACK_MOD
#:endfor
